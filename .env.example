# ==============================================================================
# Library Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values for your local environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual '.env' file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# JDBC connection URL to the PostgreSQL instance
DB_URL=jdbc:postgresql://localhost:5432/library

# PostgreSQL database username
DB_USERNAME=postgres

# PostgreSQL database user password
DB_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 2. JWT (JSON Web Token) Security Configuration
# ------------------------------------------------------------------------------
# Base64-encoded 256-bit (or stronger) secret key used for signing JWT access tokens.
# Example generated via HMAC-SHA256 (32+ bytes):
JWT_SECRET=5F05gEkmG5Gxi6GHqehXUFlsusNdoO0tXnwuK1iUVpQ=

# Refresh token validity duration in milliseconds (Default: 7 days = 604800000 ms)
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 3. Server Configuration (Optional overrides)
# ------------------------------------------------------------------------------
# Port on which the Spring Boot application listens (Default: 8080)
SERVER_PORT=8080
